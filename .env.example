# Создаётся автоматически, если подключить Upstash через маркетплейс Vercel.
# Иначе — скопируйте из консоли upstash.com -> ваша база -> REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Пароль для входа в панель управления.
ADMIN_PASSWORD=change-me

# Секрет для подписи сессионной cookie. Любая длинная случайная строка.
AUTH_SECRET=change-me-too-please-make-it-long-and-random
